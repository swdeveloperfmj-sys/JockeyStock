# MongoDB connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/jockey?retryWrites=true&w=majority

# Optional API port for local development
PORT=5000

# Login session (use a long, random value in production)
SESSION_SECRET=replace_with_a_long_random_secret
# Frontend URL(s) permitted to send the session cookie (comma-separated when needed)
FRONTEND_ORIGIN=http://localhost:5173,https://jockeys.vercel.app

# Cloudinary product image storage (keep API_SECRET on the backend only)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Automatic order notifications (email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-your-smtp-password
EMAIL_FROM=notifications@example.com

# Automatic order notifications (Textware SMS). Set ENABLED=true only with valid credentials.
TEXTWARE_SMS_ENABLED=false
TEXTWARE_SMS_URL=https://msg.text-ware.com/send_sms.php
TEXTWARE_SMS_USERNAME=
TEXTWARE_SMS_PASSWORD=
TEXTWARE_SMS_SENDER_ID=
