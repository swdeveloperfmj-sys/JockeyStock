# MongoDB connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/jockey?retryWrites=true&w=majority

# Optional API port for local development
PORT=5000

# Login session (use a long, random value in production)
SESSION_SECRET=replace_with_a_long_random_secret
# Frontend URL permitted to send the session cookie
FRONTEND_ORIGIN=http://localhost:5173

# Cloudinary product image storage (keep API_SECRET on the backend only)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
